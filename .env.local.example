# Local PostgreSQL development environment
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=marula
POSTGRES_USER=marula
POSTGRES_PASSWORD=marula_dev_password

# Local MinIO development environment
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=marula
MINIO_ROOT_PASSWORD=marula_dev_password
MINIO_ACCESS_KEY=marula
MINIO_SECRET_KEY=marula_dev_password
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_BUCKET=marula-raw
MINIO_SECURE=false

# Energy Charts API
ENERGY_CHARTS_BASE_URL=https://api.energy-charts.info
ENERGY_CHARTS_TIMEOUT_SECONDS=30
